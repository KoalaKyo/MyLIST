{
  "name": "windows-client",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:debug-client": "tauri build --debug --no-bundle",
    "build:nsis-core": "tauri build --bundles nsis && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postprocess-installer.ps1",
    "build:installer": "npm run package:installer",
    "build:web-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-web-installer.ps1",
    "package:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1 -Mode test",
    "package:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1 -Mode installer"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.337",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
